# Password-protected reverse proxy to the vendor-check service (unix socket, see taste.service).
# setup.sh installs this file; certbot then adds the TLS server block and the redirect.
server {
    listen 80;
    listen [::]:80;
    server_name getfletcher.ai www.getfletcher.ai;

    auth_basic "Vendor check";
    auth_basic_user_file /etc/nginx/getfletcher.htpasswd;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-ancestors 'none'" always;

    client_max_body_size 4k;

    location / {
        proxy_pass http://unix:/run/taste/taste.sock:;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }
}
